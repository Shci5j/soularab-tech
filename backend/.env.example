# Copy to .env in your deployment environment; never commit real secrets.
SOULARAB_ENV=local
SOULARAB_DATA_DIR=./data
SOULARAB_API_TOKEN=
SOULARAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Rooh inference engine (llama.cpp OpenAI-compatible server)
LLAMA_CPP_BASE_URL=http://127.0.0.1:8081
LLAMA_CPP_TIMEOUT_SECONDS=180
