# Copy to .env.production and replace every placeholder.
# Point your domain's DNS A/AAAA record to the public IP of this server.
APP_DOMAIN=api.example.com

# Generate a long random value; never commit the real token.
SOULARAB_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Keep local-only engines disabled until they are installed on this server.
LLAMA_CPP_BASE_URL=http://127.0.0.1:8081
LLAMA_CPP_TIMEOUT_SECONDS=180
COMFYUI_BASE_URL=http://127.0.0.1:8188
WHISPER_CPP_BASE_URL=http://127.0.0.1:8080
