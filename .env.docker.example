# Copy this file to .env before starting Docker Compose.
# Generate a long random secret; never commit the real .env file.
SOULARAB_API_TOKEN=replace-with-a-long-random-secret
APP_PORT=8080
SOULARAB_CORS_ORIGINS=http://localhost:8080,https://soularab.pages.dev,https://localhost,capacitor://localhost
LLAMA_CPP_BASE_URL=http://127.0.0.1:8081
LLAMA_CPP_TIMEOUT_SECONDS=180

# Optional local media engines on the same Docker network.
# Attach your ComfyUI and whisper.cpp server containers to soularab_internal.
COMFYUI_BASE_URL=http://comfyui:8188
WHISPER_CPP_BASE_URL=http://whisper:8080
SOULARAB_ALLOW_DOCKER_MEDIA=true
SOULARAB_MEDIA_TIMEOUT_SECONDS=180
